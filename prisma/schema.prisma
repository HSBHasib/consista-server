generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ==========================================
// BETTER AUTH COMPATIBLE MODELS
// ==========================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- App Specific User Fields ---
  timezone      String    @default("UTC") // Auto-detected or user specified (e.g., "Asia/Dhaka")
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)

  // --- Better Auth Relations ---
  sessions      Session[]
  accounts      Account[]

  // --- Application Relations ---
  deviceTokens         DeviceToken[]
  tasks                Task[]
  taskOccurrences      TaskOccurrence[]
  dailyActivities      DailyActivity[]
  yearlyReports        YearlyReport[]
  leaderboardSnapshots LeaderboardSnapshot[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?   // Used by Better Auth credentials provider
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   // Target Email or Identifier
  value      String   // OTP Code or Token
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ==========================================
// FCM PUSH NOTIFICATION DEVICE TOKENS
// ==========================================

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  fcmToken   String   @unique
  deviceType String?  // e.g. "chrome", "android", "ios"
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_token")
}

// ==========================================
// TASK & RECURRING OCCURRENCE ENGINE
// ==========================================

enum Urgency {
  NORMAL    // No alert
  MEDIUM    // Push Notification WITH sound
}

enum RecurrenceUnit {
  HOUR
  DAY
}

enum OccurrenceStatus {
  PENDING
  COMPLETED
  MISSED
}

model Task {
  id                   String          @id @default(cuid())
  userId               String
  title                String
  description          String?
  isRequired           Boolean         @default(false) // Required tasks determine streak success
  urgency              Urgency         @default(NORMAL)
  earlyReminderMinutes Int?            // Presets like 5, 10, 15, or custom minutes before

  // Finite Recurrence Configuration
  intervalValue        Int?            // e.g., 1, 2, 5
  intervalUnit         RecurrenceUnit? // HOUR or DAY
  repeatCount          Int             @default(1) // Number of finite occurrences (1 = Non-recurring)

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences TaskOccurrence[]

  @@map("task")
}

model TaskOccurrence {
  id                   String           @id @default(cuid())
  taskId               String
  userId               String
  
  scheduledAt          DateTime         // UTC Instant for task time
  reminderScheduledAt  DateTime?        // UTC Instant for early reminder
  status               OccurrenceStatus @default(PENDING)
  completedAt          DateTime?        // Recorded when completed before local midnight

  isRequired           Boolean          @default(false) // Preserves historical requirement status
  
  // Notification Delivery & Duplicate Prevention Flags
  earlyReminderSent    Boolean          @default(false)
  earlyReminderSentAt  DateTime?
  
  scheduledAlertSent   Boolean          @default(false)
  scheduledAlertSentAt DateTime?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@map("task_occurrence")
}

// ==========================================
// DAILY ACTIVITY & ANALYTICS
// ==========================================

enum DailyStatus {
  SUCCESSFUL    // Required task(s) existed AND ALL required occurrences completed
  MISSED        // Required task(s) existed BUT >=1 required occurrence missed
  NO_ACTIVITY   // Zero task occurrences existed for that calendar day
  OPTIONAL_ONLY // Task occurrences existed, BUT zero required occurrences
}

model DailyActivity {
  id                     String      @id @default(cuid())
  userId                 String
  date                   String      // Format: "YYYY-MM-DD" in user's local timezone

  status                 DailyStatus

  totalRequiredTasks     Int         @default(0) // Total required occurrences on this day
  completedRequiredTasks Int         @default(0) // Completed required occurrences on this day
  totalOptionalTasks     Int         @default(0) // Total non-required occurrences on this day
  completedOptionalTasks Int         @default(0) // Completed non-required occurrences on this day

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, status])
  @@map("daily_activity")
}

// ==========================================
// YEARLY LEADERBOARD & ANNUAL REPORTS
// ==========================================

model YearlyReport {
  id                    String   @id @default(cuid())
  userId                String
  year                  Int      

  yearlyConsistencyPct  Float    // Score based on Consistency Formula
  totalTasksCompleted   Int      @default(0)
  successfulDaysCount   Int      @default(0)
  missedDaysCount       Int      @default(0)
  noActivityDaysCount   Int      @default(0)
  optionalOnlyDaysCount Int      @default(0)
  streakBreaksCount     Int      @default(0)
  finalRank             Int?     // Final leaderboard position for that year

  reportData            Json     // Stores complete monthly breakdown & statistics JSON
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("yearly_report")
}

model LeaderboardSnapshot {
  id                  String   @id @default(cuid())
  userId              String
  year                Int      
  rank                Int
  
  currentStreakAtEnd  Int
  longestStreakAtEnd  Int
  consistencyPct      Float
  streakBreaks        Int
  totalCompletedTasks Int

  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("leaderboard_snapshot")
}


